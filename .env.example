# =============================================================================
# Grenor - variaveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Project Settings > API Keys)
# -----------------------------------------------------------------------------
# O Supabase tem dois formatos de chave. Os nomes das variaveis aqui seguem a
# Secao 11 do CLAUDE.md, mas aceitam qualquer um dos dois:
#
#   formato novo            formato legado      variavel
#   sb_publishable_...      anon public         NEXT_PUBLIC_SUPABASE_ANON_KEY
#   sb_secret_...           service_role        SUPABASE_SERVICE_ROLE_KEY
#
# Projetos criados recentemente ja nascem com o formato novo.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"

# Chave secreta: acesso irrestrito ao banco e ao Storage.
# Somente server-side. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# -----------------------------------------------------------------------------
# Banco (Project Settings > Database > Connection string)
# -----------------------------------------------------------------------------
# Runtime da aplicacao: pooler em modo transaction (porta 6543).
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# CLI do Prisma (migrate, seed): conexao direta (porta 5432).
# Necessaria porque o pooler em modo transaction nao executa DDL.
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Opcional: banco sombra para `prisma migrate dev` detectar drift.
# So preencha se o provedor nao permitir criar o shadow database sozinho.
# SHADOW_DATABASE_URL="postgresql://..."

# -----------------------------------------------------------------------------
# IA (Anthropic)
# -----------------------------------------------------------------------------
# A aplicacao funciona 100% sem IA. Com AI_ENABLED=false, a categorizacao usa
# apenas regras + revisao manual e o parecer executivo vira texto manual.
AI_ENABLED="false"
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
# URL publica, usada nos redirects de auth e nos links de relatorio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
